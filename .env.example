# Security & Authentication
JWT_SECRET=sketchai-jwt-secret-key-collaborative-game-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Generative AI (Google Gemini LLM - Optional: Built-in dynamic fallback generator included)
